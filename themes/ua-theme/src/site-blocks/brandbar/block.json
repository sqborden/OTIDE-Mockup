{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "ua-theme/brandbar",
  "version": "0.1.0",
  "title": "Brandbar",
  "category": "ua_site_blocks",
  "icon": "admin-home",
  "description": "A block for placing the brandbar in the header. Uneditable.",
  "attributes": {
    "lock": {
        "type": "object",
        "default": {
            "move": true,
            "remove": true
        }
    }
  },
  "editorStyle": ["https://assetfiles.ua.edu/fonts/fa_v6/fontawesome.css", "file:../../../assets/css/minerva.css", "file:editor.css"],
  "supports": {
    "html": false,
    "anchor": false,
    "className": false,
    "lock": true
  },
  "textdomain": "ua-theme"
}