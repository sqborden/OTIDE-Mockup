{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "ua-blocks/contact-card",
  "version": "0.1.4",
  "title": "Contact Card",
  "category": "ua_page_blocks",
  "icon": "cover-image",
  "description": "Card can be used to surface content and link to other pages that may be relevant to the user, providing a preview of what the user can expect to find on that page.",
  "editorStyle": "file:editor.css",
 "attributes": {
    "headingLevel": {
      "type": "integer",
      "default": 3
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "subtitle": {
      "type": "string",
      "default": ""
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "opensInNewTab": {
      "type": "boolean",
      "default": false
    },
    "mediaId": {
      "type": "number"
    },
    "showImage": {
      "type": "boolean",
      "default": false
    },
    "img": {
      "type": "object",
      "default": {
        "src" : "",
        "alt" : ""
      }
    },
    "email": {
      "type": "string",
      "default": ""
    },
    "phone": {
      "type": "string",
      "default": ""
    },
    "location": {
      "type": "string",
      "default": ""
    },
    "website": {
      "type": "string",
      "default": ""
    },
    "aspectRatio": {
      "type": "string",
      "default": ""
    },
    "textAlignment": {
      "type": "string",
      "default": ""
    },
    "isLandscape": {
      "type": "boolean",
      "default": false
    },
    "personTags": {
      "type": "array",
      "default":[]
    },
    "selectedPostType": {
      "type": "string",
      "default": "directory"
    },
    "selectedPost": {
      "type": "object",
      "default": null
    },
    "imageToggle": {
      "type": "boolean",
      "default": true
    },
    "tagsToggle": {
      "type": "boolean",
      "default": true
    },
    "emailToggle": {
      "type": "boolean",
      "default": true
    },
    "phoneToggle": {
      "type": "boolean",
      "default": true
    },
    "locationToggle": {
      "type": "boolean",
      "default": true
    },
    "websiteToggle": {
      "type": "boolean",
      "default": true
    },
    "linkToggle": {
      "type": "boolean",
      "default": true
    },
    "descriptionToggle": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "anchor": false,
    "className": true
  },
  "example": {
    "attributes": {
      "url": "#",
      "text": "An example"
    }
  },
  "textdomain": "ua-blocks"
}
