{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "ua-blocks/minerva-grid",
  "version": "0.1.4",
  "title": "Minerva Grid",
  "category": "ua_page_blocks",
  "icon": "grid-view",
  "description": "Minerva Grid",
  "attributes": {
    "gridType": {
      "type": "string",
      "default": ""
    },
    "maxColumns": {
      "type": "number",
      "default": 0
    }
  },
  "providesContext": {
    "gridType": "gridType"
  },
  
  "supports": {
    "spacing": {
      "blockGap": ["horizontal", "vertical"]
    },
    "html": false,
    "anchor": true,
    "className": false,
    "align": ["wide","full"]
  },
  "editorStyle": "file:./editor.css",
  "example": {
    "attributes": {
      "url": "#",
      "text": "An example"
    }
  },
  "textdomain": "ua-blocks"
}
