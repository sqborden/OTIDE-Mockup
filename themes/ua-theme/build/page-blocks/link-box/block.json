{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "ua-blocks/link-box",
  "version": "0.1.4",
  "title": "Link Box",
  "category": "ua_page_blocks",
  "icon": "paperclip",
  "description": "Link boxes can be used to surface content and link to other pages that may be relevant to the user, providing a preview of what the user can expect to find on that page.",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "opensInNewTab": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "type": "string",
      "default": ""
    },
    "iconAltText": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": false,
    "className": true
  },
  "example": {
    "attributes": {
      "url": "#",
      "text": "An example"
    }
  },
  "textdomain": "ua-blocks"
}